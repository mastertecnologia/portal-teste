# Exemplo de variáveis de ambiente para o portal (Linux /var/www/portal)
# Copie para .env e ajuste os valores. Não versionar .env.
#
# Infraestrutura atual (servidores separados):
#   Portal: 10.0.2.25 | PostgreSQL: 10.0.2.23 | ERP/Grid: 10.0.2.7 (ECS-MASTER)
# A URL do ERP (urlerp) NÃO fica aqui: fica no banco (empresas.urlerp).
# No banco use: http://10.0.2.7:85/WebGridPGM/ (com barra no final).
# Ver docs/INFRAESTRUTURA_SERVIDORES.md
#
# Estrutura no servidor: public/, config/, logs/, src/ (não usar pasta app)
# Integração ERP: empresas.urlerp e empresas.token no banco; chave/filial em UserConstants.php

# Pasta pública (DocumentRoot no Apache/Nginx)
WEBROOT_DIR=public

# Pasta da aplicação (use src; a pasta app não existe nesta estrutura)
APP_DIR=src

# NÃO defina APP_BASE=/portal se quiser URLs na raiz (portal.pgm.inf.br/users/login).
# Só use APP_BASE se o site for servido em subdiretório por necessidade do servidor.
# APP_BASE=

# Banco PostgreSQL (servidor 10.0.2.23; Portal roda em 10.0.2.25)
DB_HOST=10.0.2.23
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=pgm@postgres
DB_DATABASE=pgm

# Segurança (obrigatório em produção – gere uma string longa e aleatória)
SECURITY_SALT=gere-uma-string-aleatoria-longa-aqui

# Cofre de senhas (Bancosenhas): opcional. Se definido (mín. 16 caracteres), novas credenciais e trocas
# usam AES-256-CBC com prefixo v2: no banco; registros antigos continuam com criptografia legada até serem regravados.
# Gere com: openssl rand -base64 32
# VAULT_ENCRYPTION_KEY=

# Produção
DEBUG=false

# Idioma e formatação (Intl): mensagens do framework Cake e validações padrão
APP_DEFAULT_LOCALE=pt_BR

# RBAC: off | warn | enforce — enforce bloqueia telas por matriz de papéis (ver config/rbac.php)
# RBAC_MODE=enforce

# E-mail padrão (Transport default Cake)
# MAIL_DEFAULT_HOST=smtp.exemplo.com
# MAIL_DEFAULT_PORT=587
# MAIL_DEFAULT_USERNAME=
# MAIL_DEFAULT_PASSWORD=
# MAIL_DEFAULT_TLS=true

# Transports adicionais em config/app.php (master / pgm) — opcional
# MAIL_MASTER_HOST=mail.exemplo.com
# MAIL_MASTER_PORT=587
# MAIL_MASTER_USERNAME=
# MAIL_MASTER_PASSWORD=
# MAIL_MASTER_TLS=true
# MAIL_PGM_HOST=mail.exemplo.com
# MAIL_PGM_PORT=587
# MAIL_PGM_USERNAME=
# MAIL_PGM_PASSWORD=
# MAIL_PGM_TLS=true

# URL absoluta do site (links, e-mails). Lida em config/app.php → App.fullBaseUrl.
# Se vazio, o bootstrap monta a partir de HTTP_HOST/HTTPS. app_local.php pode sobrescrever.
# APP_FULL_BASE_URL=https://portal.seudominio.com

# Opcional: codificação (padrão UTF-8)
# APP_ENCODING=UTF-8

# Opcional: Speedio + Sintegra (cadastro/CNPJ). Não commitar valores reais.
# SPEEDIO_USERNAME=
# SPEEDIO_TOKEN=
# SPEEDIO_PASSWORD=
# SINTEGRA_API_KEY=

# Deploy PaaS / Redis (URL única em vez de DB_HOST etc.)
# DATABASE_URL=
# CACHE_DEFAULT_URL=
# EMAIL_TRANSPORT_DEFAULT_URL=
# LOG_DEBUG_URL=
# LOG_ERROR_URL=

# ── Módulo de contratos (Fase 6: PDFs, e-mails, cron contract_alerts) ─────────
# Pasta persistente (deve terminar com /). O deploy cria uploads/contracts/{pdfs,signed,documents}.
# CONTRACT_PDF_STORAGE_PATH=/var/www/portal/uploads/contracts/
#
# E-mail (ContractNotificationService)
# CONTRACT_NOTIFY_FROM_EMAIL=noreply@seudominio.com
# CONTRACT_NOTIFY_FROM_NAME=PGM Contratos
# CONTRACT_NOTIFY_TEAM_EMAIL=contratos@seudominio.com
#
# Alertas do shell contract_alerts (opcional)
# CONTRACT_AVISO_VENCIMENTO_DIAS=30
# CONTRACT_ALERTS_AUTO_CLOSE=false
# CONTRACT_ALERTS_MARK_ENDING=false
#
# Autentique (Fase 7) — POST JSON + multipart em …/v2/graphql
# CONTRACT_AUTENTIQUE_ENABLED=false
# CONTRACT_AUTENTIQUE_API_BASE=https://api.autentique.com.br/v2/graphql
# CONTRACT_AUTENTIQUE_API_KEY=
# CONTRACT_AUTENTIQUE_WEBHOOK_SECRET=
# Sandbox não consome créditos (documentos apagados após alguns dias)
# CONTRACT_AUTENTIQUE_SANDBOX=true
