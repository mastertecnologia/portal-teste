# Exemplo de variáveis de ambiente para o portal (Linux /var/www/portal)
# Copie para .env e ajuste os valores. Não versionar .env.
#
# Infraestrutura atual (servidores separados):
#   Portal: 10.0.2.25 | PostgreSQL: 10.0.2.23 | ERP/Grid: 10.0.2.7 (ECS-MASTER)
# A URL do ERP (urlerp) NÃO fica aqui: fica no banco (empresas.urlerp).
# No banco use: http://10.0.2.7:85/WebGridPGM/ (com barra no final).
# Ver docs/INFRAESTRUTURA_SERVIDORES.md
#
# Estrutura no servidor: public/, config/, logs/, src/ (não usar pasta app)
# Integração ERP: empresas.urlerp e empresas.token no banco; chave/filial em UserConstants.php

# Pasta pública (DocumentRoot no Apache/Nginx)
WEBROOT_DIR=public

# Pasta da aplicação (use src; a pasta app não existe nesta estrutura)
APP_DIR=src

# NÃO defina APP_BASE=/portal se quiser URLs na raiz (portal.pgm.inf.br/users/login).
# Só use APP_BASE se o site for servido em subdiretório por necessidade do servidor.
# APP_BASE=

# Banco PostgreSQL (servidor 10.0.2.23; Portal roda em 10.0.2.25)
DB_HOST=10.0.2.23
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=pgm@postgres
DB_DATABASE=pgm

# Segurança (obrigatório em produção – gere uma string longa e aleatória)
SECURITY_SALT=gere-uma-string-aleatoria-longa-aqui

# Cofre de senhas (Bancosenhas): opcional. Se definido (mín. 16 caracteres), novas credenciais e trocas
# usam AES-256-CBC com prefixo v2: no banco; registros antigos continuam com criptografia legada até serem regravados.
# Gere com: openssl rand -base64 32
# VAULT_ENCRYPTION_KEY=

# Produção
DEBUG=false

# RBAC: off | warn | enforce — enforce bloqueia telas por matriz de papéis (ver config/rbac.php)
# RBAC_MODE=enforce

# E-mail padrão (Transport default Cake)
# MAIL_DEFAULT_HOST=smtp.exemplo.com
# MAIL_DEFAULT_PORT=587
# MAIL_DEFAULT_USERNAME=
# MAIL_DEFAULT_PASSWORD=
# MAIL_DEFAULT_TLS=true

# Opcional: se estiver atrás de proxy/SSL e o PHP não receber HTTPS,
# defina fullBaseUrl em config/app_local.php em vez de usar variável aqui.
# APP_FULL_BASE_URL=https://portal.seudominio.com

# Opcional: Speedio (consulta CNPJ). Não commitar .env com valores reais.
# SPEEDIO_USERNAME=
# SPEEDIO_TOKEN=
