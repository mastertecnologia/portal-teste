# Copie para ".env" na raiz do projeto (o ficheiro .env não é versionado).
#
# WSL com código em /mnt/c/...: cache/sessões usam /tmp/pgm-portal-* (ext4). Opcional:
#CAKE_TMP=/home/seu_user/.cache/pgm-portal-teste
# Formato: uma variável por linha, KEY=VALUE (ver config/bootstrap.php).
#
# Variáveis RBAC opcionais: config/rbac.env.example
#
# Recomendado em produção: chave dedicada (≥16 caracteres) para cofre e senhas de certificado fiscal (VaultCrypto).
#VAULT_ENCRYPTION_KEY=
#
# Exemplos frequentes (descomente e preencha no .env real):
#DB_HOST=localhost
#DB_USERNAME=
#DB_PASSWORD=
#DB_DATABASE=
#
# Módulo Fiscal (NF-e) — ver config/fiscal.php (fases 1–6; env abaixo)
# Homologação: manter FISCAL_AMBIENTE=2 até testes SEFAZ completos
# 1 = produção SEFAZ, 2 = homologação (padrão recomendado em dev)
#FISCAL_AMBIENTE=2
#FISCAL_SOAP_TIMEOUT=30
# Caminho absoluto para XMLs/certificados; predefinido: storage/fiscal na raiz da app
#FISCAL_STORAGE_PATH=
#
# Fase 2 — produção / auditoria / rede
#FISCAL_AUDIT_LOG=1
# Retentativas SOAP só para timeout/rede (0–3)
#FISCAL_SOAP_RETRY_MAX=0
#FISCAL_SOAP_RETRY_DELAY_MS=500
# Referência para política de arquivo (logs/checklist); purge BD: bin/cake fiscal_maintenance purge_xmls
# Purge ficheiros inutilização (disco): bin/cake fiscal_maintenance purge_inutilizacao
# Purge respostas DF-e gravadas em disco: bin/cake fiscal_maintenance purge_distribuicao
# URLs opcionais do serviço nacional Distribuição DF-e (predefinições em config/fiscal.php)
#FISCAL_NACIONAL_DIST_DFE_URL=
#FISCAL_NACIONAL_DIST_DFE_URL_HOM=
#FISCAL_XML_RETENTION_DAYS=365
# Estudo IBS/CBS (LC 214/2025) — não altera XML até NT vigente; ver Fiscal.reforma_tributaria em config/fiscal.php
#FISCAL_REFORMA_ESTUDO_IBSCBS=0

# SPED Fiscal: omitir_sem_dados (sem cadastro completo do contabilista → sem linha 0100) | sempre_stub (linha 0100 vazia)
# Versão do leiaute no registro 0000 (ex.: 015); alinhar ao PVA instalado
#FISCAL_SPED_COD_VER=015
#FISCAL_SPED_0100_MODO=omitir_sem_dados
# TIPO_ITEM do registro 0200 (00=revenda, 04=produto acabado, … ver Guia EFD)
#FISCAL_SPED_TIPO_ITEM_PADRAO=00
# Limite de linhas H010 por arquivo (SPED inventário)
#FISCAL_SPED_INVENTARIO_MAX_ITENS=5000
#
# Integração ERP → Portal (JSON: clientes, produtos, ordens; ver config/erp_api.php e docs/HARDENING_PRODUCAO_PORTAL.md)
# 1/true = empresa e token só em headers HTTP (nunca na query string)
#ERP_API_HEADER_ONLY=0
# Origens CORS permitidas, separadas por vírgula (vazio = Access-Control-Allow-Origin: * como legado)
#ERP_API_CORS_ORIGINS=https://10.0.2.7:85,http://10.0.2.7:85

# Smoke desenvolvimento (migrate + testes fiscal): composer fiscal-verify
# ou bin/fiscal_dev.ps1 (Windows) / bash bin/fiscal_dev.sh (Linux/macOS)
#
# NFS-e piloto GINFES/GISS (Itu/SP IBGE 3523909 — ver docs/FISCAL_NFSE_PILOTO.md)
#NFSE_GINFES_WSDL=https://v2-ws-homologacao.giss.com.br/service-ws/nf/nfse-ws?wsdl
#NFSE_GINFES_LOCAL_CERT_PEM=
# recepcionar_lote_v3 | abrasf_gerar_nfse
#NFSE_GINFES_MODE=recepcionar_lote_v3
#NFSE_GINFES_SOAP_OPERATION=RecepcionarLoteRpsV3
#
# Sidebar React (migração incremental; 0 = menu Cake atual em default.ctp)
#PGM_SIDEBAR_REACT=0
#
# Opcional: credenciais só para `npm run capture:admin-audit-round3` (evite commitar;
# preferir ficheiro gitignored `scripts/.pgm_audit_password` com uma linha = senha).
#PGM_BASE_URL=https://portal.exemplo/portal
#PGM_EMAIL=
#PGM_PASSWORD=
#
# Workflow + SLA por etapa (Service Desk)
#WORKFLOW_ENABLED=1
#WORKFLOW_SLA_ENABLED=1
#WORKFLOW_AUTO_ESCALATION_ENABLED=1
# E-mails de gestor no auto-escalonamento SLA (lista separada por vírgula; opcional — fallback Config.emailtickets / empresas.email)
#WORKFLOW_SLA_MANAGER_EMAIL=gestor@empresa.com
# Opcional: restringe empresas habilitadas (lista separada por vírgula)
#WORKFLOW_EMPRESAS=1,2
#
# workflow_sla_policies: após migration AlterWorkflowSlaPoliciesEmpresaNullable, linhas com empresa_id NULL
# servem política global (fallback); caso contrário use só linhas por empresa.
#
# Protótipo Service Desk — fila de aprovações (fechamento: só tickets resolvidos recentes)
#SERVICEDESK_APROVACOES_FECHAMENTO_DIAS=30
# Piloto approval_requests (dual-write RBAC; requer bin/cake migrations migrate)
#APPROVAL_REQUESTS_DUAL_WRITE_RBAC=1
#
# Web Push (notificações no navegador) — gere chaves com: npx web-push generate-vapid-keys
#WEB_PUSH_VAPID_PUBLIC=
#WEB_PUSH_VAPID_PRIVATE=
#
# UI premium (mock pgm_erp_completo_2.html) — switchover; ver docs/MIGRACAO_PGM_ERP_COMPLETO.md
#PORTAL_UI_MODE=mixed
#PORTAL_PREMIUM_MODULES=clientes,orcamentos,servicedesk
#PORTAL_UI_MODE=premium
# (lista vazia = todos os módulos Fases 0–5; opt-out na URL: ?legacy=1)
