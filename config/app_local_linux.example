<?php
/**
 * Exemplo de configuração LOCAL para produção Linux.
 * Estrutura: /var/www/portal com public/, config/, logs/, src/ (sem app).
 * Banco PostgreSQL em servidor remoto (10.0.2.23).
 * Integração ERP Windows: urlerp e token no banco (empresas); chave/filial em UserConstants.php.
 *
 * Uso:
 * 1. Copie para app_local.php: cp app_local_linux.example config/app_local.php
 * 2. Ajuste SECURITY_SALT, banco e fullBaseUrl (SSL) se necessário.
 * 3. Nunca versionar app_local.php (deve estar no .gitignore).
 */
return [
    'debug' => false,

    'Security' => [
        'salt' => env('SECURITY_SALT', 'gere-uma-string-aleatoria-longa-aqui'),
    ],

    'Datasources' => [
        'default' => [
            'host' => env('DB_HOST', '10.0.2.23'),
            'port' => env('DB_PORT', '5432'),
            'username' => env('DB_USERNAME', 'postgres'),
            'password' => env('DB_PASSWORD', 'pgm@postgres'),
            'database' => env('DB_DATABASE', 'pgm'),
        ],
    ],

    // SSL/HTTPS: se já configurou SSL no servidor, o CakePHP usa env('HTTPS') para fullBaseUrl.
    // Se estiver atrás de proxy que não repassa HTTPS, descomente e ajuste:
    // 'App' => [
    //     'fullBaseUrl' => 'https://portal.seudominio.com',
    // ],
];
