<?php
/**
 * Produção Linux — modelo mínimo quando o `.env` já define DB_*, SECURITY_SALT, MAIL_*.
 *
 *   cp config/app_local_linux.example config/app_local.php
 *
 * Não coloque aqui password/username/host do PostgreSQL: o Cake lê `config/app.php` + `.env`.
 * Se `app_local.php` antigo tiver `'Datasources' => ['default' => ['password' => '...']]`, apague
 * esse bloco ou substitua por este ficheiro para não duplicar segredos em disco.
 *
 * Permissões (Apache/php-fpm como www-data precisa ler DB_PASSWORD):
 *   chown root:www-data /var/www/portal/.env && chmod 640 /var/www/portal/.env
 *   systemctl restart php*-fpm apache2
 * Alternativa: env[DB_PASSWORD]=... no pool PHP-FPM (sem world-readable no .env).
 */
return [
	'debug' => false,

	// Opcional: URL absoluta se o proxy não repassar HTTPS ao PHP
	// 'App' => [ 'fullBaseUrl' => 'https://portal.seudominio.com' ],
];
