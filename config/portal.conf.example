# Portal COM /portal na URL: https://portal.pgm.inf.br/portal/users/login
# Para URL sem /portal (portal.pgm.inf.br/users/login), use config/portal-raiz.conf.example

# ========== HTTP (porta 80) – redireciona para HTTPS exceto /portal (Integrador) ==========
# O Integrador no Windows usa http://10.0.2.25/portal/... e não segue redirect 301.
# Por isso NÃO redirecionamos requisições para /portal; só o resto vai para HTTPS.
<VirtualHost *:80>
    ServerName portal.pgm.inf.br
    ServerAlias 10.0.2.25

    DocumentRoot /var/www/portal/public

    # Redireciona para HTTPS apenas quando a URL NÃO for /portal (Integrador usa HTTP em /portal)
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/portal
    RewriteRule ^ https://portal.pgm.inf.br%{REQUEST_URI} [R=301,L]

    Alias /portal /var/www/portal/public
    <Directory /var/www/portal/public>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
        Options -Indexes +FollowSymLinks
    </Directory>

    SetEnv WEBROOT_DIR "public"
    SetEnv APP_DIR "src"
    SetEnv APP_BASE "/portal"
    SetEnv MAIL_MASTER_HOST "mail.pgm.inf.br"
    SetEnv MAIL_MASTER_PORT "587"
    SetEnv MAIL_MASTER_USERNAME "helpdesk@pgm.inf.br"
    SetEnv MAIL_MASTER_TLS "false"
    SetEnv MAIL_PGM_HOST "mail.pgm.inf.br"
    SetEnv MAIL_PGM_PORT "587"
    SetEnv MAIL_PGM_USERNAME "helpdesk@pgm.inf.br"
    SetEnv MAIL_PGM_TLS "false"
    # Senhas: preferir EnvironmentFile root-only + PassEnv (evita texto plano no vhost)
    PassEnv MAIL_MASTER_PASSWORD
    PassEnv MAIL_PGM_PASSWORD
</VirtualHost>

# ========== HTTPS (porta 443) ==========

<VirtualHost *:443>
    ServerName portal.pgm.inf.br

    DocumentRoot /var/www/portal/public

    # IMPORTANTE: Rewrite ANTES do Alias, para /portal/arquivo existente ser servido como /arquivo pelo DocumentRoot
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/portal/(.+)$
    RewriteCond /var/www/portal/public/%1 -f
    RewriteRule ^portal/(.+)$ /$1 [L]

    Alias /portal /var/www/portal/public

    <Directory /var/www/portal/public>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
        Options -Indexes +FollowSymLinks
    </Directory>

    SSLEngine on
    SSLCertificateFile      /etc/ssl/portal/portal.crt
    SSLCertificateKeyFile   /etc/ssl/portal/portal.key
    # Se seu PFX tiver certificado intermediário separado, adicione:
    # SSLCertificateChainFile /etc/ssl/portal/chain.crt

    SetEnv WEBROOT_DIR "public"
    SetEnv APP_DIR "src"
    SetEnv APP_BASE "/portal"
    SetEnv HTTPS "on"
    SetEnv MAIL_MASTER_HOST "mail.pgm.inf.br"
    SetEnv MAIL_MASTER_PORT "587"
    SetEnv MAIL_MASTER_USERNAME "helpdesk@pgm.inf.br"
    SetEnv MAIL_MASTER_TLS "false"
    SetEnv MAIL_PGM_HOST "mail.pgm.inf.br"
    SetEnv MAIL_PGM_PORT "587"
    SetEnv MAIL_PGM_USERNAME "helpdesk@pgm.inf.br"
    SetEnv MAIL_PGM_TLS "false"
    # Senhas: preferir EnvironmentFile root-only + PassEnv (evita texto plano no vhost)
    PassEnv MAIL_MASTER_PASSWORD
    PassEnv MAIL_PGM_PASSWORD

    ErrorLog ${APACHE_LOG_DIR}/portal_error_ssl.log
    CustomLog ${APACHE_LOG_DIR}/portal_access_ssl.log combined
</VirtualHost>
