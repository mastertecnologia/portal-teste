# Variáveis opcionais de RBAC — copiar linhas para o ficheiro `.env` na raiz do projeto
# (modelo geral: `.env.example` na raiz; este ficheiro detalha só RBAC). Ver `config/bootstrap.php`.
# Semântica completa: docblock de `config/rbac.php`.
#
# Desenvolvimento local (repositório já define enforce + menu + auditoria + políticas em config/rbac.php):
#RBAC_MODE=warn
#RBAC_MODE=off
#
#RBAC_MENU_FILTER_CONFIG=0
#RBAC_MENU_FILTER_SIDEBAR=0
#
# Piloto: logar cada pedido de utilizador autenticado sem papéis em rbac_users_roles
#RBAC_LOG_UNASSIGNED_USERS=1
#
#RBAC_AUDIT_DECISIONS_DB=0
#RBAC_AUDIT_DECISIONS_DB=all
#
# Só após backfill completo da equipa (ver docs/TEST_CHECKLIST_RBAC.md)
#RBAC_ENFORCE_BLOCK_WITHOUT_ROLES=1
#
#RBAC_EVALUATE_POLICIES=0
#RBAC_WARN_FLASH=1
#
# IAM: expiração de grants (cron + jobs); default em rbac.php=OFF (rollout dia 0). Ativar com 1.
#RBAC_ACCESS_EXPIRATION_ENABLED=1
#
# Módulo fiscal (NF-e): variáveis FISCAL_* na raiz — ver `.env.example` e `config/fiscal.php`.
# Testes/comandos: `composer fiscal-verify`, `bin/fiscal_dev.ps1`, `bin/fiscal_dev.sh`.
