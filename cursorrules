audit_log JSON, created

-- portal_tokens
id, orcamento_id, token VARCHAR(64), usado BOOL DEFAULT 0, usado_em,
expira_em DATETIME, bloqueado BOOL DEFAULT 0, tentativas INT DEFAULT 0, created

-- produtos (catálogo)
