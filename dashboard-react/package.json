{
    "name": "pgm-erp-dashboard",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node ../scripts/postbuild_tickets_app_sync.cjs",
        "build:tickets": "npm run build",
        "dev:sidebar": "vite --config vite.sidebar.config.js",
        "build:sidebar": "vite build --config vite.sidebar.config.js",
        "preview": "vite preview",
        "start": "vite --open --host",
        "lint": "eslint \"src/**/*.{js,jsx}\"",
        "test": "vitest run"
    },
    "dependencies": {
        "axios": "^1.15.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.30.3"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.0",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.1",
        "vite": "^5.4.0",
        "vitest": "^4.1.5"
    }
}
