<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    syntaxCheck="false"
    bootstrap="./tests/bootstrap.php"
    >
    <php>
        <ini name="memory_limit" value="-1"/>
        <ini name="apc.enable_cli" value="1"/>
    </php>

    <!-- Add any additional test suites you want to run here -->
    <testsuites>
        <testsuite name="App Test Suite">
            <directory>./tests/TestCase</directory>
            <exclude>./tests/TestCase/Integration</exclude>
        </testsuite>
        <!-- Autorização RBAC/ABAC — alinhar com `composer test-rbac`; acrescente ficheiros aqui ao criar testes novos neste âmbito. -->
        <testsuite name="rbac">
            <file>tests/TestCase/Utility/RbacCheckerTest.php</file>
            <file>tests/TestCase/Utility/RbacPolicyConditionsTest.php</file>
            <file>tests/TestCase/Utility/RbacPermissionResolverTest.php</file>
            <file>tests/TestCase/Utility/RbacUserRolesResolverTest.php</file>
            <file>tests/TestCase/Utility/RbacEffectivePermissionIdsTest.php</file>
            <file>tests/TestCase/Utility/RbacClientePortalTest.php</file>
            <file>tests/TestCase/Utility/RbacHierarchyTest.php</file>
            <file>tests/TestCase/Utility/AbacQueryTest.php</file>
            <file>tests/TestCase/Controller/Component/RbacComponentWhitelistTest.php</file>
            <file>tests/TestCase/Controller/Component/RbacComponentApiEnforcedTest.php</file>
            <file>tests/TestCase/Shell/RbacRolloutShellTest.php</file>
            <file>tests/TestCase/Config/RbacPhpConfigTest.php</file>
            <file>tests/TestCase/Config/AbacPhpConfigTest.php</file>
            <file>tests/TestCase/Config/PermissionsRegistryFiscalTest.php</file>
        </testsuite>
        <!-- Integração mínima ORM + SQLite em memória (pdo_sqlite); composer test-rbac corre este suite num segundo processo -->
        <!-- Utilitários e registry fiscal (bootstrap padrão tests/bootstrap.php). HTTP fiscal: composer test-fiscal-http, bin/fiscal_dev.sh | fiscal_dev.ps1, ou suite rbac-http. -->
        <testsuite name="fiscal">
            <file>tests/TestCase/Config/PermissionsRegistryFiscalTest.php</file>
            <file>tests/TestCase/Utility/FiscalCertificadoSecretTest.php</file>
            <file>tests/TestCase/Utility/FiscalDfeDocZipSummaryTest.php</file>
            <file>tests/TestCase/Utility/FiscalProducaoGateTest.php</file>
            <file>tests/TestCase/Utility/FiscalRegimeHelperTest.php</file>
            <file>tests/TestCase/Utility/FiscalResNfeImportParserTest.php</file>
            <file>tests/TestCase/Utility/FiscalValidatorEmitenteTest.php</file>
            <file>tests/TestCase/Utility/FiscalValidatorNfseTest.php</file>
            <file>tests/TestCase/Utility/FiscalXmlBuilderManifestacaoTest.php</file>
            <file>tests/TestCase/Utility/NfseEmissorResolverTest.php</file>
            <file>tests/TestCase/Utility/NfseEmissorGinfesTest.php</file>
        </testsuite>
        <testsuite name="rbac-integration">
            <file>tests/TestCase/Integration/RbacEffectivePermissionIdsSqliteTest.php</file>
        </testsuite>
        <!-- Stack HTTP + SQLite (:memory:); requer bootstrap dedicado (composer test-rbac). -->
        <testsuite name="rbac-http">
            <file>tests/TestCase/Integration/RbacPermissoesHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacAreasHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacEmpresasusersHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacProblemasHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacFeriadosHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacContratosHorasHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacNormasempresaHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacFinanceiroHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacFiscalHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacFiscalNotasHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacFiscalMoreHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacFaturamentoHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacClientesHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacPrefaturamentoHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacBancosenhasHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacEmpresasHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacOrcamentosHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacProdutosHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacVisitasHttpTest.php</file>
            <file>tests/TestCase/Integration/RbacOrdensservicoHttpTest.php</file>
        </testsuite>
    </testsuites>

    <!-- FixtureInjector: reativar para fixtures Cake completas + PostgreSQL de teste, se necessário. -->

    <!-- Ignore vendor tests in code coverage reports -->
    <filter>
        <whitelist>
            <directory suffix=".php">./src/</directory>
            <directory suffix=".php">./plugins/*/src/</directory>
        </whitelist>
    </filter>
</phpunit>
